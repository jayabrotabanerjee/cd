//Write a C program for constructing of LL (1) parsing.
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
// --- Stack Implementation ---
char stack[100];
int top = -1;
void push(char c) {
if (top >= 99) {
printf("Stack Overflow\n");
} else {
stack[++top] = c;
}
}
char pop() {
if (top < 0) {
return '$'; // Stack empty
} else {
return stack[top--];
}
}
// --- Parser Globals ---
char input[100];
int ip = 0; // Input pointer
// The hard-coded LL(1) Parse Table
// Rows: E, R(E'), T, S(T'), F
// Cols: i(id), +, *, (, ), $
const char *table[5][6] = {
// i + * ( ) $
{ "TR", "err", "err", "TR", "err", "err" }, // E
{ "err", "+TR", "err", "err", "e", "e" }, // R (E')
{ "FS", "err", "err", "FS", "err", "err" }, // T
{ "err", "e", "*FS", "err", "e", "e" }, // S (T')
{ "i", "err", "err", "(E)", "err", "err" } // F
};
// --- Helper Functions ---
/**
*/
* @brief Prints the current stack state
void printStack() {
printf("%-20s", "Stack: ");
for (int i = 0; i <= top; i++) {
printf("%c", stack[i]);
}
}
/**
* @brief Prints the remaining input
*/
void printInput() {
printf("%-20s", "Input: ");
printf("%s\n", &input[ip]);
}
/**
*/
* @brief Maps a non-terminal character to its table row index
int non_terminal_to_row(char c) {
switch (c) {
case 'E': return 0;
case 'R': return 1;
case 'T': return 2;
case 'S': return 3;
case 'F': return 4;
default: return -1; // Should not happen
}
}
/**
*/
* @brief Maps a terminal character to its table column index
int terminal_to_col(char c) {
switch (c) {
case 'i': return 0;
case '+': return 1;
case '*': return 2;
case '(': return 3;
case ')': return 4;
case '$': return 5;
default: return -1; // Should not happen
}
}
/**
*/
* @brief Checks if a character is a non-terminal
int isNonTerminal(char c) {
return c == 'E' || c == 'R' || c == 'T' || c == 'S' || c == 'F';
}
/**
* @brief Pre-processes the input string,
* replacing all alphabetic chars with 'i' (for id)
* and appending '$'.
*/
void preprocessInput(char *raw_input) {
int j = 0;
for (int i = 0; raw_input[i] != '\0'; i++) {
if (isalpha(raw_input[i])) {
// Add 'i' only once for a multi-char id
if (j == 0 || input[j-1] != 'i') {
input[j++] = 'i';
}
} else if (strchr("+*()", raw_input[i])) {
input[j++] = raw_input[i];
}
}
input[j++] = '$'; // Append end-of-string marker
input[j] = '\0';
printf("Processed Input: %s\n", input);
}
// --- Main Parsing Function ---
int main() {
char raw_input[100];
printf("Enter an expression (e.g., a+b*c or (a+b)*c ): ");
scanf("%99s", raw_input);
preprocessInput(raw_input);
printf("--------------------------------------------------\n");
printf("Parse Trace:\n\n");
// 1. Initialize stack
push('$');
push('E'); // Push start symbol
int accepted = 0;
// 2. Main parsing loop
while (top > -1) { // While stack is not empty
printStack();
printInput();
char X = stack[top]; // Peek at stack top
char a = input[ip]; // Peek at current input
// Case 1: Stack top is a terminal
if (!isNonTerminal(X)) {
if (X == a) {
pop(); // Match!
ip++; // Advance input
printf("Action: Match '%c'\n\n", a);
} else if (X == '$' && a != '$') {
printf("Action: Error! Stack empty but input remains.\n\n");
break; // Reject
}
else {
printf("Action: Error! Mismatch: Expected '%c', found '%c'\n\n", X, a);
break; // Reject
}
}
// Case 2: Stack top is a non-terminal
else {
int row = non_terminal_to_row(X);
int col = terminal_to_col(a);
if (row == -1 || col == -1) {
printf("Action: Error! Invalid symbol.\n\n");
break; // Reject
}
const char *rule = table[row][col];
printf("Action: Apply rule %c -> %s\n\n", X, rule);
if (strcmp(rule, "err") == 0) {
printf("Action: Error! No rule in table.\n\n");
break; // Reject
}
// Pop the non-terminal
pop();
// Push the rule onto the stack in reverse
// (Skip if it's the epsilon rule "e")
if (strcmp(rule, "e") != 0) {
int len = strlen(rule);
for (int i = len - 1; i >= 0; i--) {
push(rule[i]);
}
}
}
// Check for acceptance
if (stack[top] == '$' && input[ip] == '$') {
accepted = 1;
break;
}
}
// 3. Final Result
printf("--------------------------------------------------\n");
if (accepted) {
printf("Success: String parsed successfully.\n");
} else {
printf("Failure: String contains syntax errors.\n");
}
return 0;
}
