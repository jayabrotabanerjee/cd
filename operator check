int main() {
char token[20]; // Buffer to hold the input token
printf("Enter a token to check if it's an operator: ");
// Read a single "word" from the user
scanf("%19s", token);
if (isOperator(token)) {
printf("\nResult: '%s' is a valid operator.\n", token);
} else {
printf("\nResult: '%s' is NOT a valid operator.\n", token);
}
return 0;
}
