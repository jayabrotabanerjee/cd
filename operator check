//Write a C program to simulate lexical analyzer for validating operators.
#include <stdio.h>
#include <string.h>
/**
* @brief Checks if a given token is a valid C operator.
* @param token The input string to check.
* @return 1 (true) if it's an operator, 0 (false) otherwise.
*/
int isOperator(const char* token) {
// A comprehensive list of C operators
const char* operators[] = {
// Arithmetic
"+", "-", "*", "/", "%", "++", "--",
// Relational
"==", "!=", ">", "<", ">=", "<=",
// Logical
"&&", "||", "!",
// Bitwise
"&", "|", "^", "~", "<<", ">>",
// Assignment
"=", "+=", "-=", "*=", "/=", "%=",
"&=", "|=", "^=", "<<=", ">>=",
// Member/Pointer
".", "->",
// Other
"?", ":", ",", ";",
// sizeof (often treated as operator)
// "sizeof", // Uncomment if you want to include it
// Sentinel to mark the end of the array
NULL
};
// Loop through the list and compare
for (int i = 0; operators[i] != NULL; i++) {
if (strcmp(token, operators[i]) == 0) {
return 1; // Found a match
}
}
// No match found
return 0;
}
