//Implement the lexical analyzer using JLex, flex or other lexical analyzer generating tools.
/* Section 1: C Definitions and Flex Options */
%{
#include <stdio.h>
#include <string.h>
/* This enum defines the token types.
A parser (like Yacc/Bison) would use these integer codes. */
typedef enum {
T_KEYWORD = 1,
T_IDENTIFIER,
T_NUMBER,
T_OPERATOR,
T_SPECIAL,
T_UNKNOWN
} TokenType;
/* Flex automatically provides:
- yylineno: The current line number (int)
- yytext: The matched string (char*)
- yyleng: The length of the matched string (int)
*/
%}
/* Define a "start condition" for handling multi-line comments */
%x COMMENT
/* --- Section 2: Rules (Patterns and Actions) --- */
%%
/* --- A. Ignore Whitespace and Comments --- */
/* Ignore spaces and tabs */
[ \t]+ { /* no action, just ignore */ }
/* Handle newlines and increment line counter */
\n { yylineno++; }
/* Ignore single-line comments */
"//"[^\n]* { /* ignore everything until newline */ }
/* Multi-line comment handling using our "COMMENT" state */
"/*" { BEGIN(COMMENT); }
<COMMENT>[^*\n]* { /* eat non-star, non-newline text */ }
<COMMENT>\n { yylineno++; }
<COMMENT>"*"+[^/\n] { /* eat stars not followed by slash */ }
<COMMENT>"*/" { BEGIN(INITIAL); } /* Return to default state */
<COMMENT><<EOF>> {
/* Handle unterminated comment */
printf("<Line %d> Error: Unterminated comment.\n", yylineno);
BEGIN(INITIAL);
return 0; /* Signal EOF */
}
/* --- B. Token Rules (Keywords) --- */
/* Keywords must be listed before the identifier rule
so they are matched first. */
"int" { return T_KEYWORD; }
"void" { return T_KEYWORD; }
"char" { return T_KEYWORD; }
"float" { return T_KEYWORD; }
"double" { return T_KEYWORD; }
"if" { return T_KEYWORD; }
"else" { return T_KEYWORD; }
"while" { return T_KEYWORD; }
"for" { return T_KEYWORD; }
"return" { return T_KEYWORD; }
/* --- C. Token Rules (Identifiers, Numbers) --- */
/* Identifiers */
[a-zA-Z_][a-zA-Z0-9_]* {
/* Handle the length restriction from the prompt */
if (yyleng > 31) {
printf("<Line %d> Warning: Identifier '%.*s...' truncated.\n",
yylineno, 31, yytext);
}
return T_IDENTIFIER;
}
/* Numbers (simple integers) */
[0-9]+ { return T_NUMBER; }
/* --- D. Token Rules (Operators) --- */
/* Multi-character operators first for longest match */
"=="|"!="|"<="|">="|"&&"|"||"|"++"|"--"
|"+="|"-="|"*="|"/="|"->" { return T_OPERATOR; }
/* Single-character operators */
[+\-*/%=<>&|!^~.?:] { return T_OPERATOR; }
/* --- E. Token Rules (Special Symbols) --- */
[(){};,\[\]] { return T_SPECIAL; }
/* --- F. Unknown Character Rule --- */
/* Match any other character */
. {
printf("<Line %d> Unknown token: %s\n", yylineno, yytext);
return T_UNKNOWN;
}
%%
/* --- Section 3: C Code (Main function and wrappers) --- */
/* Global variable for the input file (Flex reads from yyin) */
extern FILE *yyin;
/* Helper function to get token name as string */
const char* tokenToString(int token_type) {
switch(token_type) {
case T_KEYWORD: return "KEYWORD";
case T_IDENTIFIER: return "IDENTIFIER";
case T_NUMBER: return "NUMBER";
case T_OPERATOR: return "OPERATOR";
case T_SPECIAL: return "SPECIAL_SYMBOL";
default: return "UNKNOWN";
}
}
/* Main driver function */
int main(int argc, char *argv[]) {
if (argc < 2) {
fprintf(stderr, "Usage: %s <input_file>\n", argv[0]);
return 1;
}
yyin = fopen(argv[1], "r");
if (yyin == NULL) {
perror(argv[1]); // e.g., "input.txt: No such file or directory"
return 1;
}
/* Set yylineno to 1 (it's good practice) */
yylineno = 1;
int token_type;
printf("--- Lexical Analyzer Start (using Flex) --- \n\n");
printf("%-10s %-20s %-20s\n", "Line", "Token Type", "Lexeme");
printf("--------------------------------------------------\n");
/* yylex() is the main lexer function generated by Flex.
It returns 0 at the end of the file. */
while (token_type = yylex()) {
printf("%-10d %-20s %-20s\n",
yylineno,
tokenToString(token_type),
yytext);
}
printf("--------------------------------------------------\n");
printf("\n--- Lexical Analysis Complete --- \n");
fclose(yyin);
return 0;
}
/* yywrap() function - called by Flex at end-of-file. */
int yywrap() {
return 1; // 1 means we are done parsing this file.
}
