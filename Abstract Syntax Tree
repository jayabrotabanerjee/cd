//Write a C program to generate machine code from abstract syntax tree generated by the parser. The instruction set specified in Note 2 may be considered as the target code.
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
typedef enum { NODE_ASSIGN, NODE_EXPR, NODE_TERM,
NODE_FACTOR, NODE_NUM, NODE_ID } NodeType;
typedef struct ASTNode {
NodeType type;
char op; // +,-,*,/
char* name; // identifier
int value; // number
struct ASTNode* left;
struct ASTNode* right;
} ASTNode;
// Register counter
int regCount = 0;
// Function to get a new register
char* newReg() {
static char reg[10];
sprintf(reg, "R%d", regCount++);
return strdup(reg);
}
// Generate machine code from AST, return register storing the result
char* generateCode(ASTNode* node) {
if (!node) return NULL;
if (node->type == NODE_NUM) {
char* reg = newReg();
printf("LOAD %s, %d\n", reg, node->value);
return reg;
}
else if (node->type == NODE_ID) {
char* reg = newReg();
printf("LOAD %s, %s\n", reg, node->name);
return reg;
}
else if (node->type == NODE_EXPR || node->type == NODE_TERM) {
char* reg1 = generateCode(node->left);
char* reg2 = generateCode(node->right);
switch(node->op) {
case '+': printf("ADD %s, %s\n", reg1, reg2); break;
case '-': printf("SUB %s, %s\n", reg1, reg2); break;
case '*': printf("MUL %s, %s\n", reg1, reg2); break;
case '/': printf("DIV %s, %s\n", reg1, reg2); break;
}
return reg1;
}
else if (node->type == NODE_ASSIGN) {
char* reg = generateCode(node->left);
printf("STORE %s, %s\n", node->name, reg);
return reg;
}
return NULL;
}
// Helper to create AST nodes
ASTNode* createNode(NodeType type, char* name, int value, char op,
ASTNode* left, ASTNode* right) {
ASTNode* node = (ASTNode*)malloc(sizeof(ASTNode));
node->type = type;
node->name = name ? strdup(name) : NULL;
node->value = value;
node->op = op;
node->left = left;
node->right = right;
return node;
}
int main() {
// Example AST for: x = 2 + 3 * 4
ASTNode* expr = createNode(NODE_EXPR, NULL, 0, '+',
createNode(NODE_NUM, NULL, 2, 0, NULL, NULL),
createNode(NODE_TERM, NULL, 0, '*',
createNode(NODE_NUM, NULL, 3, 0, NULL, NULL),
createNode(NODE_NUM, NULL, 4, 0, NULL, NULL)
)
);
ASTNode* assign = createNode(NODE_ASSIGN, "x", 0, 0, expr, NULL);
printf("Generated Machine Code:\n");
generateCode(assign);
return 0;
}
